<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The UI shared by the browser client (DoiQ.Client) and the MAUI app (DoiQ.App): pages, components, services and
       the static css/js, served to both as _content/DoiQ.Client.UI/... Namespaces stay DoiQ.Client.*. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DoiQ.Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DoiQ.Shared\DoiQ.Shared.csproj" />
  </ItemGroup>

</Project>

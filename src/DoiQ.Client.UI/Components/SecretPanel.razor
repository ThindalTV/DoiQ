@inject IJSRuntime JS

<section class="secret-panel" aria-labelledby="secret-h">
    <div class="sec-head">
        <h3 id="secret-h">@Title</h3>
        <button type="button" class="btn btn-sm right" @onclick="OnDismiss">I have copied it</button>
    </div>
    <p class="warn">Copy this now. It won't be shown again.</p>

    @foreach (var (label, value) in Items)
    {
        <div class="secret-row">
            <span class="k">@label</span>
            <code>@value</code>
            <button type="button" class="btn btn-sm" @onclick="() => Copy(value)">@(_copied == value ? "Copied" : "Copy")</button>
        </div>
    }

    <div class="secret-row">
        <span class="k">MCP URL</span>
        <code>@McpUrl</code>
        <button type="button" class="btn btn-sm" @onclick="() => Copy(McpUrl)">@(_copied == McpUrl ? "Copied" : "Copy")</button>
    </div>
    <div class="secret-row">
        <span class="k">Auth header</span>
        <code>X-Api-Key: &lt;the API key&gt;</code>
        <span class="muted" style="font-size:12px">or Authorization: Bearer</span>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IReadOnlyList<(string Label, string Value)> Items { get; set; } = [];
    [Parameter, EditorRequired] public string McpUrl { get; set; } = "";
    [Parameter] public EventCallback OnDismiss { get; set; }

    private string? _copied;

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("doiq.copy", text); _copied = text; }
        catch (JSException) { _copied = null; }
    }
}

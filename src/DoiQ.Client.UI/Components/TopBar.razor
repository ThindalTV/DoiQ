<header class="topbar">
    <div class="brand">
        <Icon Name="logo" Size="22" />
        <h1>DoiQ</h1>
    </div>
    <span class="menu-wrap board-switch">
        <button type="button" id="board-switch" class="btn board-btn" aria-haspopup="menu" aria-expanded="@Aria.Bool(_boardMenu)" title="Switch board (B)" @onclick="ToggleBoardMenu">
            <span class="sr">Board:</span>
            <span class="board-name">@(CurrentBoard?.Name ?? "Board")</span>
            <Icon Name="chevron" Size="10" />
            <kbd>B</kbd>
        </button>
        @if (_boardMenu)
        {
            <div class="menu board-menu" role="menu" aria-label="Boards">
                @foreach (var b in Boards)
                {
                    var id = b.Id;
                    <button type="button" role="menuitemradio" aria-checked="@Aria.Bool(id == CurrentBoardId)" @onclick="() => Pick(id)">
                        <span class="board-name">@b.Name</span>
                        <span class="menu-count">@b.OpenTasks open</span>
                    </button>
                }
                @if (Options.Administration)
                {
                    <a class="menu-link" role="menuitem" href="settings#boards" @onclick="() => _boardMenu = false">Manage boards…</a>
                }
            </div>
        }
    </span>
    <div class="grow"></div>
    <div class="presence">
        <span class="dot" aria-hidden="true"></span>
        <span>@PresenceText</span>
        <span class="sep" aria-hidden="true">|</span>
        <span class="conn conn-@Connection.ToString().ToLowerInvariant()" role="status" title="@ConnectionHint">
            <span class="dot" aria-hidden="true"></span>@(Connection switch { HubState.Live => "Live", HubState.Offline => "Offline", HubState.Connecting => "Connecting", _ => "Reconnecting" })
        </span>
    </div>
    <a class="btn" href="settings" title="Settings (,)">Settings</a>
    <button type="button" class="btn" @onclick="OnSignOut">Sign out</button>
    <button type="button" class="btn btn-icon" aria-label="Keyboard shortcuts" @onclick="OnShowShortcuts">?</button>
    <button type="button" class="btn btn-primary" @onclick="OnNewTask">
        <Icon Name="plus" Size="14" />
        New task
        <kbd>N</kbd>
    </button>
</header>

<div role="toolbar" aria-label="Filter and sort" class="toolbar">
    <label class="search">
        <Icon Name="search" Size="16" />
        <span class="sr">Search</span>
        <input type="search" id="search" @ref="_search" placeholder="Search titles, fields and comments"
               value="@Filter.Search" @oninput="OnSearch" />
        <kbd>/</kbd>
    </label>

    <div role="group" aria-label="Assignee" class="seg">
        <button type="button" aria-pressed="@Aria.Bool(Filter.Assignee == AssigneeFilter.All)" @onclick="() => SetAssignee(AssigneeFilter.All)">All</button>
        <button type="button" aria-pressed="@Aria.Bool(Filter.Assignee == AssigneeFilter.Me)" @onclick="() => SetAssignee(AssigneeFilter.Me)">Me</button>
        <span class="menu-wrap">
            <button type="button" aria-pressed="@Aria.Bool(Filter.Assignee == AssigneeFilter.Agents)" aria-haspopup="menu" aria-expanded="@Aria.Bool(_menu)"
                    style="border-left:1px solid var(--border-strong)" @onclick="() => _menu = !_menu">
                @(Filter.Assignee == AssigneeFilter.Agents && Filter.AgentName is not null ? Filter.AgentName : "Agents")
                <Icon Name="chevron" Size="10" />
            </button>
            @if (_menu)
            {
                <div class="menu" role="menu">
                    <button type="button" role="menuitemradio" aria-checked="@Aria.Bool(Filter.AgentName is null)" @onclick="() => PickAgent(null)">Any agent</button>
                    @foreach (var a in Agents)
                    {
                        var name = a;
                        <button type="button" role="menuitemradio" aria-checked="@Aria.Bool(Filter.AgentName == name)" @onclick="() => PickAgent(name)">@name</button>
                    }
                </div>
            }
        </span>
        <button type="button" aria-pressed="@Aria.Bool(Filter.Assignee == AssigneeFilter.Unassigned)" @onclick="() => SetAssignee(AssigneeFilter.Unassigned)">Unassigned</button>
    </div>

    <button type="button" class="btn" aria-pressed="@Aria.Bool(Filter.NeedsMe)" @onclick="ToggleNeedsMe" title="Waiting on you (F)">
        Needs me
        <span class="count-badge">@NeedsMeCount</span>
    </button>

    <div class="grow"></div>

    @if (!Filter.CanReorder)
    {
        <span class="reorder-hint" role="status">Reordering is off while sorted by @BoardFilter.SortName(Filter.Sort)</span>
    }

    <label class="select-label">
        Sort
        <select @onchange="OnSort">
            <option value="@SortMode.LaneOrder" selected="@(Filter.Sort == SortMode.LaneOrder)">Lane order (priority)</option>
            <option value="@SortMode.RecentlyUpdated" selected="@(Filter.Sort == SortMode.RecentlyUpdated)">Recently updated</option>
            <option value="@SortMode.Created" selected="@(Filter.Sort == SortMode.Created)">Created</option>
            <option value="@SortMode.DueDate" selected="@(Filter.Sort == SortMode.DueDate)">Due date</option>
            <option value="@SortMode.Title" selected="@(Filter.Sort == SortMode.Title)">Title</option>
        </select>
    </label>

    @if (CurrentBoardId != 0)
    {
        <a class="btn" href="board/@CurrentBoardId/archive" title="Archived tasks (Shift A)">Archive</a>
    }
</div>

@code {
    [Parameter, EditorRequired] public BoardFilter Filter { get; set; } = default!;
    [Parameter] public IReadOnlyList<string> Agents { get; set; } = [];
    [Parameter] public int NeedsMeCount { get; set; }
    [Parameter] public string PresenceText { get; set; } = "";
    [Parameter] public HubState Connection { get; set; } = HubState.Live;

    private string ConnectionHint => Connection switch
    {
        HubState.Live => "Changes appear as they happen.",
        HubState.Offline => "No connection to the server. Retrying; the board catches up when it is back.",
        _ => "Connecting to the server. The board catches up when it is back.",
    };
    [Parameter] public IReadOnlyList<BoardDto> Boards { get; set; } = [];
    [Parameter] public int CurrentBoardId { get; set; }
    [Parameter] public EventCallback<int> OnSwitchBoard { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnNewTask { get; set; }
    [Parameter] public EventCallback OnShowShortcuts { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }

    private ElementReference _search;
    private bool _menu, _boardMenu, _focusBoardMenu;

    private BoardDto? CurrentBoard => Boards.FirstOrDefault(b => b.Id == CurrentBoardId);

    public ValueTask FocusSearch() => _search.FocusAsync();

    public bool BoardMenuOpen => _boardMenu;

    public void ToggleBoardMenu()
    {
        _boardMenu = !_boardMenu;
        _focusBoardMenu = _boardMenu;
        StateHasChanged();
    }

    public void CloseBoardMenu()
    {
        _boardMenu = false;
        StateHasChanged();
    }

    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;

    private ClientOptions Options => Services.GetService(typeof(ClientOptions)) as ClientOptions ?? ClientOptions.Default;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Opened from the keyboard or mouse: put focus on the board shown, so Tab/Enter work from there.
        if (_focusBoardMenu)
        {
            _focusBoardMenu = false;
            await JS.InvokeVoidAsync("doiq.focus", ".board-menu [aria-checked=true]");
        }
    }

    private Task Pick(int id)
    {
        _boardMenu = false;
        return OnSwitchBoard.InvokeAsync(id);
    }

    private Task OnSearch(ChangeEventArgs e) { Filter.Search = e.Value?.ToString() ?? ""; return OnChanged.InvokeAsync(); }

    private Task SetAssignee(AssigneeFilter f)
    {
        Filter.Assignee = f;
        Filter.AgentName = null;
        _menu = false;
        return OnChanged.InvokeAsync();
    }

    private Task PickAgent(string? name)
    {
        Filter.Assignee = AssigneeFilter.Agents;
        Filter.AgentName = name;
        _menu = false;
        return OnChanged.InvokeAsync();
    }

    private Task ToggleNeedsMe() { Filter.NeedsMe = !Filter.NeedsMe; return OnChanged.InvokeAsync(); }

    private Task OnSort(ChangeEventArgs e)
    {
        Filter.Sort = Enum.Parse<SortMode>(e.Value?.ToString() ?? nameof(SortMode.LaneOrder));
        return OnChanged.InvokeAsync();
    }
}

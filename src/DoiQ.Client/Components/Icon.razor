@switch (Name)
{
    case "calendar":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 12 12" aria-hidden="true"><rect x="1" y="2" width="10" height="9" fill="none" class="s-muted" stroke-width="1.25" /><path d="M1 5h10M4 1v2M8 1v2" class="s-muted" stroke-width="1.25" /></svg>
        break;
    case "clock":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="5" fill="none" class="s-muted" stroke-width="1.25" /><path d="M6 3v3l2 1.5" fill="none" class="s-muted" stroke-width="1.25" /></svg>
        break;
    case "subtasks":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 12 12" aria-hidden="true"><rect x="1" y="1" width="10" height="10" fill="none" class="s-muted" stroke-width="1.25" /><path d="M3.5 6l1.8 1.8L8.5 4.3" fill="none" class="s-muted" stroke-width="1.25" /></svg>
        break;
    case "fields":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 3h8M2 6h8M2 9h5" class="s-muted" stroke-width="1.25" /></svg>
        break;
    case "comment":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 2h9v6H6l-3 2.5V8H1.5z" fill="none" class="s-muted" stroke-width="1.25" /></svg>
        break;
    case "mail":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 14 14" aria-hidden="true"><rect x="1" y="3" width="12" height="8" fill="none" class="s-muted" stroke-width="1.25" /><path d="M1.5 3.5L7 8l5.5-4.5" fill="none" class="s-muted" stroke-width="1.25" /></svg>
        break;
    case "plus":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v12M1 7h12" style="stroke:@Stroke" stroke-width="1.75" /></svg>
        break;
    case "search":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" class="s-muted" stroke-width="1.5" /><path d="M11 11l4 4" class="s-muted" stroke-width="1.5" /></svg>
        break;
    case "chevron":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" class="s-ink" stroke-width="1.5" /></svg>
        break;
    case "close":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" class="s-ink" stroke-width="1.5" /></svg>
        break;
    case "pencil":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 12l1-3 6.5-6.5 2 2L5 11z" fill="none" class="s-muted" stroke-width="1.25" /></svg>
        break;
    case "logo":
        <svg class="ic ic-@Name" width="@Size" height="@Size" viewBox="13 13 96 96" aria-hidden="true"><rect x="18" y="18" width="78" height="78" rx="20" fill="none" class="s-accent" stroke-width="9" /><rect x="31" y="34" width="9" height="40" rx="4.5" class="f-new" /><rect x="45" y="34" width="9" height="26" rx="4.5" class="f-waiting" /><rect x="59" y="34" width="9" height="46" rx="4.5" class="f-doing" /><rect x="73" y="34" width="9" height="20" rx="4.5" class="f-done" /><path d="M82 82 L104 104" class="s-accent" stroke-width="10" stroke-linecap="round" /></svg>
        break;
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 12;
    [Parameter] public string Stroke { get; set; } = "var(--on-accent)";
}

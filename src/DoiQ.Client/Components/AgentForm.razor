@using System.Security.Cryptography

<form class="agent-form" @onsubmit="Submit">
    <div class="form-grid">
        <label for="@Id("name")">Name</label>
        <input id="@Id("name")" class="field" type="text" @bind="_m.Name" @bind:event="oninput" />

        <label for="@Id("ini")">Initials</label>
        <input id="@Id("ini")" class="field" type="text" maxlength="3" style="width:90px" placeholder="auto" @bind="_m.Initials" @bind:event="oninput" />

        <span class="k">Triage</span>
        <label class="check-label"><input type="checkbox" @bind="_m.IsTriage" />This agent triages new tasks</label>

        <label for="@Id("wh")">Webhook URL</label>
        <input id="@Id("wh")" class="field" type="url" placeholder="https://…" @bind="_m.WebhookUrl" @bind:event="oninput" />

        <label for="@Id("sec")">Webhook secret</label>
        <div class="inline">
            <input id="@Id("sec")" class="field" type="text" autocomplete="off" spellcheck="false"
                   placeholder="@(Existing is { HasWebhookSecret: true } ? "Leave blank to keep the current secret" : "Optional")"
                   @bind="_m.WebhookSecret" @bind:event="oninput" />
            <button type="button" class="btn btn-sm" @onclick="Generate">Generate</button>
        </div>

        <label for="@Id("nu")">Notify URL</label>
        <input id="@Id("nu")" class="field" type="url" placeholder="https://…" @bind="_m.NotifyUrl" @bind:event="oninput" />
    </div>

    @if (_error is not null) { <p class="form-error" role="alert">@_error</p> }
    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm" disabled="@Busy">@(Existing is null ? "Add agent" : "Save changes")</button>
        <button type="button" class="btn btn-sm" @onclick="OnCancel">Cancel</button>
    </div>
</form>

@code {
    /// <summary>The agent being edited; null when adding.</summary>
    [Parameter] public AgentAdminDto? Existing { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<AgentFormModel> OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private AgentFormModel _m = new();
    private string? _error;

    protected override void OnInitialized()
    {
        if (Existing is { } a)
            _m = new AgentFormModel { Name = a.Name, Initials = a.Initials, IsTriage = a.IsTriage, WebhookUrl = a.WebhookUrl ?? "", NotifyUrl = a.NotifyUrl ?? "" };
    }

    private string Id(string part) => $"af-{Existing?.Id ?? 0}-{part}";

    private void Generate() => _m.WebhookSecret = Convert.ToHexString(RandomNumberGenerator.GetBytes(32)).ToLowerInvariant();

    private async Task Submit()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_m.Name)) { _error = "Name is required."; return; }
        await OnSave.InvokeAsync(_m);
    }
}

@code {
    public sealed class AgentFormModel
    {
        public string Name { get; set; } = "";
        public string Initials { get; set; } = "";
        public bool IsTriage { get; set; }
        public string WebhookUrl { get; set; } = "";
        public string WebhookSecret { get; set; } = "";
        public string NotifyUrl { get; set; } = "";
    }
}
